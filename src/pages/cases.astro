---
import Base from "../layouts/Base.astro";
const questions = [
  [
    "最初に何を確認しますか？",
    "いつから・どこに・何が変わったかを記録する",
    "昨日までの運動、発症時刻、左右差、腫脹と全身状態を共有します。熱感だけでSDFTの損傷と確定はできません。",
  ],
  [
    "どの評価を組み合わせますか？",
    "獣医師による診察と、必要に応じた画像評価",
    "触診、歩様と病変の局在を確認し、超音波等を選びます。骨折が疑われる場合に、歩かせて確認しようとしてはいけません。",
  ],
  [
    "冷却できたら、治癒も進んだと考えますか？",
    "温度と治癒を別々に考える",
    "正常馬での冷却実験は温度低下を示しますが、競走復帰期間の短縮や再発率低下を同時に示すものではありません。",
  ],
  [
    "いつ運動を増やしますか？",
    "症状・画像・現在の負荷への反応を再評価する",
    "日数だけで進めず、病変と個体に合わせた段階的な計画を獣医師と立てます。復帰判断をこの症例教材だけで行うことはできません。",
  ],
];
---

<Base title="症例学習：調教翌日の前肢の熱感">
  <div class="wrap section" style="max-width:940px">
    <div class="page-title">
      <span class="eyebrow">CASE 001 / FICTIONAL EDUCATIONAL CASE</span>
      <h1>調教翌日、前肢に熱感。</h1>
      <p>
        架空の学習症例：4歳のサラブレッド。高速調教の翌朝、左前肢のSDFT領域に熱感と軽い腫脹が認められました。
      </p>
    </div>
    <div class="note">
      回答を選んで解説を開き、自分の判断理由と比べてみてください。実際の馬の診断・処方を示すものではありません。
    </div>
    {questions.map(([q, a, ex], i) => (
      <section style="margin-top:32px">
        <span class="eyebrow">QUESTION 0{i + 1}</span>
        <h2 style="font-size:21px">{q}</h2>
        <details class="case-answer">
          <summary>{a}</summary>
          <p>
            <strong>Evidence-based Explanation</strong>
            <br />
            {ex}
          </p>
        </details>
      </section>
    ))}
    <div class="section">
      <h2>根拠へ戻る</h2>
      <div class="intro-links">
        <a href="/articles/tendinopathy/">屈腱炎とReferences →</a>
        <a href="/articles/cryotherapy/">冷却の研究 →</a>
        <a href="/articles/controlled-exercise/">段階的な運動 →</a>
      </div>
    </div>
  </div>
</Base>
