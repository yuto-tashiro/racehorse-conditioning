---
import Base from "../layouts/Base.astro";
const items = [
  [
    "脚に熱感・腫れがある",
    [
      ["sdft", "腱の位置を知る"],
      ["tendinopathy", "屈腱炎"],
      ["ligament-injury", "靱帯損傷"],
      ["bone-fatigue", "骨疲労"],
      ["palpation", "触診と視診"],
    ],
  ],
  [
    "走りがいつもと違う",
    [
      ["muscle-injury", "筋損傷"],
      ["eiph", "呼吸器の問題"],
      ["gastric-ulcers", "消化器の問題"],
      ["training-load", "負荷の記録"],
    ],
  ],
  [
    "運動後の回復が遅い",
    [
      ["heart-rate", "回復心拍"],
      ["hydration", "水分と電解質"],
      ["heat-stress", "暑熱障害"],
      ["recovery", "回復と管理"],
    ],
  ],
] as const;
---

<Base title="症状から学ぶ">
  <div class="wrap section">
    <div class="page-title">
      <span class="eyebrow">LEARN FROM OBSERVATIONS</span>
      <h1>気づいた変化から、学ぶ。</h1>
      <p>
        これは診断ツールではありません。症状に関係する構造・評価・病態へ進むための学習ナビゲーションです。
      </p>
    </div>
    <div class="emergency">
      <strong>EMERGENCY</strong>
      <p>
        強い腹痛、骨折の疑い、急激な重度跛行、高体温や重い呼吸困難は、速やかに獣医師へ連絡してください。
      </p>
    </div>
    {items.map(([title, links]) => (
      <section class="library-card">
        <h2>{title}</h2>
        <p>
          複数の組織・全身状態が関係し得ます。以下は鑑別の確定や網羅的な一覧ではありません。
        </p>
        <div class="intro-links">
          {links.map(([id, text]) => (
            <a href={`/articles/${id}/`}>{text} →</a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
