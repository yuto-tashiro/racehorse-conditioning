---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { categories, levels, effects, isStale } from "../../lib/evidence";
export async function getStaticPaths() {
  return (await getCollection("articles")).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const all = await getCollection("articles");
const refs = await getCollection("evidence");
const linked = d.references.map((id) => refs.find((r) => r.id === id)!);
const related = all.filter(
  (a) => d.related.includes(a.id) || a.data.related.includes(entry.id),
);
---

<Base title={d.title} description={d.description} article>
  <div class="wrap">
    <div class="breadcrumb">
      <a href="/">ホーム</a> /{" "}
      <a href={`/topics/${d.category}/`}>{categories[d.category].title}</a> /{" "}
      {d.title}
    </div>
    <div class="article-layout">
      <aside class="toc" aria-label="記事の目次">
        <strong>ON THIS PAGE</strong>
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
        <a href="#evidence">Evidence Summary</a>
        <a href="#limitations">研究上の限界</a>
        <a href="#references">References</a>
        <a href="#related">つながる知識</a>
      </aside>
      <article data-pagefind-body>
        <header class="page-title">
          <span class="eyebrow" data-pagefind-filter="分野">
            {categories[d.category].title}
          </span>
          <h1 data-pagefind-meta="title">{d.title}</h1>
          <p lang="en">{d.english}</p>
          <p style="margin-top:18px" data-pagefind-meta="description">
            {d.description}
          </p>
          <div class="article-meta">
            <span>
              Last Evidence Review:{" "}
              <time datetime={d.lastReviewed}>{d.lastReviewed}</time>
            </span>
            <span>Species: {d.species.join(" / ")}</span>
          </div>
          <div class="note">
            {d.editorialStatus}
            。掲載文献の範囲を示す教育用記事です。網羅的なシステマティックレビューではありません。
          </div>
          {isStale(d.lastReviewed) && (
            <p class="emergency">
              Evidence review older than 24 months — 文献の再確認が必要です。
            </p>
          )}
        </header>
        {d.emergency && (
          <div class="emergency" role="note">
            <strong>EMERGENCY · 緊急の獣医学的評価</strong>
            <p>
              激しい腹痛、骨折の疑い、急激な重度跛行、高体温、重度の呼吸困難などは速やかに獣医師へ連絡してください。本サイトは診断・治療の代替ではありません。
            </p>
          </div>
        )}
        <div class="prose">
          <Content />
          <h2 id="evidence">Evidence Summary</h2>
          <p>
            対象種、アウトカム、根拠の強さ、効果の方向を分けて示します。評価は掲載文献に基づく暫定的な編集判断です。
          </p>
          {d.claims.map((c) => (
            <section class="claim">
              <h3>{c.outcome}</h3>
              <div class="claim-meta">
                <span class={`tag level-${c.level}`}>
                  {c.level} — {levels[c.level]}
                </span>
                <span>Effect: {effects[c.effect]}</span>
              </div>
              <p>{c.conclusion}</p>
              <small>
                根拠：
                {c.references.map((id, i) => (
                  <>
                    <a href={`#ref-${id}`}>{id}</a>
                    {i < c.references.length - 1 ? " / " : ""}
                  </>
                ))}
              </small>
            </section>
          ))}
          <h2 id="limitations">研究上の限界 / Evidence Gap</h2>
          <p class="note">{d.limitations}</p>
          <h2 id="references">References</h2>
          {linked.map((r) => (
            <div class="reference" id={`ref-${r.id}`}>
              <strong>{r.data.title}</strong>
              <p>
                {r.data.authors.join(", ")}. {r.data.journal}. {r.data.year}.
              </p>
              <p>
                {r.data.pmid && (
                  <a href={`https://pubmed.ncbi.nlm.nih.gov/${r.data.pmid}/`}>
                    PMID: {r.data.pmid}
                  </a>
                )}{" "}
                {r.data.doi && (
                  <>
                    {" "}
                    ·{" "}
                    <a href={`https://doi.org/${r.data.doi}`}>
                      DOI: {r.data.doi}
                    </a>
                  </>
                )}
              </p>
              <p>
                確認範囲：
                {r.data.verification === "ABSTRACT"
                  ? "書誌・抄録"
                  : r.data.verification === "FULL_TEXT"
                    ? "全文"
                    : "機関公開資料"}{" "}
                · <a href={`/evidence/#${r.id}`}>研究の詳細と限界 →</a>
              </p>
            </div>
          ))}
          <h2 id="related">つながる知識</h2>
          <div class="related">
            {related.map((a) => (
              <a href={`/articles/${a.id}/`}>{a.data.title} →</a>
            ))}
          </div>
        </div>
      </article>
    </div>
  </div>
</Base>
