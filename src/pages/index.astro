---
import Base from "../layouts/Base.astro";
import Horse from "../components/Horse.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { categories, levels } from "../lib/evidence";
const articles = await getCollection("articles");
const cooling = articles.find((a) => a.id === "cryotherapy")!;
const temperature = cooling.data.claims[0];
const racing = cooling.data.claims[3];
const featured = ["sdft", "tendinopathy", "cryotherapy"].map((id) =>
  articles.find((a) => a.id === id)!,
);
---

<Base>
  <section class="hero">
    <div class="wrap hero-inner">
      <div>
        <div class="eyebrow">ANATOMY · PERFORMANCE · EVIDENCE</div>
        <h1>
          競走馬の身体を、
          <br />
          科学から理解する。
        </h1>
        <p>
          構造を知り、動きを理解し、根拠から考える。
          <br />
          解剖学から競走復帰までをつなぐ、
          <br />
          競走馬コンディショニングの学習プラットフォーム。
        </p>
        <div class="actions">
          <a class="button" href="/learn/">
            基礎から学びはじめる <span>→</span>
          </a>
          <a class="button secondary" href="/evidence/">
            Evidenceを調べる <span>↗</span>
          </a>
        </div>
      </div>
      <div class="hero-art">
        <Horse />
        <div class="art-label">STRUCTURE → FUNCTION → PERFORMANCE</div>
      </div>
    </div>
  </section>
  <div class="pathway">
    <div class="wrap">
      <a href="/articles/sdft/">01　解剖</a>
      <span>→</span>
      <a href="/articles/gallop/">02　運動・生理</a>
      <span>→</span>
      <a href="/articles/training-load/">03　負荷・適応</a>
      <span>→</span>
      <a href="/articles/tendinopathy/">04　障害・評価</a>
      <span>→</span>
      <a href="/articles/controlled-exercise/">05　介入・復帰</a>
    </div>
  </div>
  <section class="wrap section">
    <div class="section-head">
      <div>
        <span class="eyebrow">EXPLORE THE KNOWLEDGE</span>
        <h2>知りたいことから、学びをつなぐ。</h2>
      </div>
      <a href="/learn/">学習ガイドを見る →</a>
    </div>
    <div class="grid">
      {Object.entries(categories).map(([key, cat]) => (
        <a class="category-card" href={`/topics/${key}/`}>
          <span class="num">{cat.icon}</span>
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
          <h3>{cat.title}</h3>
          <span class="eyebrow">{cat.english}</span>
          <p>{cat.summary}</p>
        </a>
      ))}
    </div>
    <div class="intro-links">
      <a href="/body/">身体部位から探す →</a>
      <a href="/symptoms/">症状から学ぶ →</a>
      <a href="/cases/">症例で考える →</a>
      <a href="/glossary/">専門用語を調べる →</a>
    </div>
  </section>
  <section class="wash">
    <div class="wrap section">
      <div class="section-head">
        <div>
          <span class="eyebrow">START WITH THE ESSENTIALS</span>
          <h2>最初に読みたい、3つのテーマ。</h2>
        </div>
        <a href="/topics/basics/">基礎科学をすべて見る →</a>
      </div>
      <div class="grid">
        {featured.filter(Boolean).map((entry) => (
          <ArticleCard entry={entry} />
        ))}
      </div>
    </div>
  </section>
  <section class="wrap section evidence-intro">
    <div>
      <span class="eyebrow">OUR APPROACH TO EVIDENCE</span>
      <h2>
        「使われている」と、
        <br />
        「確かめられている」を分ける。
      </h2>
      <p>
        何が分かっているのか。どこまで分かっているのか。
        <br />
        そして、何がまだ分かっていないのか。
      </p>
      <p>
        対象種・研究デザイン・評価したアウトカムを明示し、
        <br />
        根拠の強さと、介入の有効性を別々に読み解きます。
      </p>
      <a href="/evidence-guide/" class="button secondary">
        Evidenceの読み方 <span>→</span>
      </a>
    </div>
    <div class="evidence-mini">
      <span class="eyebrow">EVIDENCE SNAPSHOT / CRYOTHERAPY</span>
      <h3>冷却で変わるのは、何か。</h3>
      <dl>
        <dt>対象</dt>
        <dd>Equine · 馬</dd>
        <dt>腱の深部温度</dt>
        <dd>
          <span class={`tag level-${temperature.level}`}>
            {temperature.level} — {levels[temperature.level].split(" · ")[0]}
          </span>{" "}
          温度低下の報告
        </dd>
        <dt>競走復帰までの期間</dt>
        <dd>
          <span class={`tag level-${racing.level}`}>
            {racing.level} — {levels[racing.level].split(" · ")[0]}
          </span>{" "}
          結論できない
        </dd>
      </dl>
      <p class="note" style="margin:17px 0 0">
        温度を下げることと、治癒を早めることは、異なるアウトカムです。
      </p>
      <a
        href="/articles/cryotherapy/"
        style="font-size:12px;display:block;margin-top:14px"
      >
        根拠と研究上の限界を読む →
      </a>
    </div>
  </section>
</Base>
